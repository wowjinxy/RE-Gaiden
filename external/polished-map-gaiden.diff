+static bool gaiden_attribute_path(const char *filename, char *buffer) {
+	std::string path(filename);
+	size_t slash = path.find_last_of("/\\");
+	std::string directory = slash == std::string::npos ? "" : path.substr(0, slash + 1);
+	std::string basename = slash == std::string::npos ? path : path.substr(slash + 1);
+	size_t first_dot = basename.find('.');
+	if (first_dot == std::string::npos) {
+		return false;
+	}
+
+	size_t tileset_dot = basename.find(".gaiden_area");
+	std::string attr;
+	if (tileset_dot != std::string::npos && tileset_dot > first_dot) {
+		attr = directory + basename.substr(0, first_dot) + "_meta" +
+			basename.substr(first_dot, tileset_dot - first_dot) + ".gaiden_area_meta.blk";
+	}
+	else {
+		tileset_dot = basename.find(".gaiden_room");
+		if (tileset_dot == std::string::npos || tileset_dot <= first_dot) {
+			return false;
+		}
+		attr = directory + basename.substr(0, first_dot) + "_collision" +
+			basename.substr(first_dot, tileset_dot - first_dot) + ".gaiden_collision.blk";
+	}
+	if (attr.size() >= FL_PATH_MAX) {
+		return false;
+	}
+	strcpy(buffer, attr.c_str());
+	return true;
+}
